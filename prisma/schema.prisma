// ─────────────────────────────────────────────────────────
// Muhammad Zain Islamic Digital Library — Prisma Schema
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma.config.ts (Prisma ORM v7)
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StorageProvider {
  LOCAL
  S3
}

enum MediaType {
  AUDIO
  PDF
  IMAGE
  VIDEO
  DOCUMENT
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ImportSource {
  TELEGRAM
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  imports Import[]

  @@map("users")
}

// ─── Category ────────────────────────────────────────────
// Translations stored as JSONB: { en?, ar?, am? }

model Category {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String  // Default/fallback display name (English)
  translations     Json    @default("{}")
  description      String?
  descTranslations Json    @default("{}")
  parentId         String?
  // UI display fields
  icon             String? // Lucide icon name string, e.g. "BookOpen"
  colorClass       String? // Tailwind colour class, e.g. "bg-amber-50 text-amber-800"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  series   Series[]
  books    Book[]
  lessons  Lesson[]

  @@map("categories")
}

// ─── Tag ─────────────────────────────────────────────────

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  lessons LessonTag[]

  @@map("tags")
}

// ─── Series ──────────────────────────────────────────────

model Series {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  translations     Json          @default("{}")
  description      String?
  descTranslations Json          @default("{}")
  categoryId       String?
  bookId           String?       // Optional: the classical text this series explains
  coverImageKey    String?
  order            Int           @default(0)
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  book     Book?     @relation("SeriesBook", fields: [bookId], references: [id])
  lessons  Lesson[]

  @@map("series")
}

// ─── Book ─────────────────────────────────────────────────

model Book {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  translations       Json          @default("{}")
  author             String?       // Default/fallback author string
  authorTranslations Json          @default("{}")  // { en?, ar?, am? }
  description        String?
  descTranslations   Json          @default("{}")
  categoryId         String?
  coverImageKey      String?
  tableOfContents    Json          @default("[]")  // Array of { chapter, title, lessonId? }
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  category    Category? @relation(fields: [categoryId], references: [id])
  lessons     Lesson[]
  media       Media[]
  seriesLinks Series[]  @relation("SeriesBook")

  @@map("books")
}

// ─── Lesson ───────────────────────────────────────────────
// May belong to a Series, a Book, both, or neither.

model Lesson {
  id               String        @id @default(cuid())
  slug             String        @unique
  lessonNumber     Int?
  title            String
  translations     Json          @default("{}")
  description      String?
  descTranslations Json          @default("{}")
  categoryId       String?
  seriesId         String?
  bookId           String?
  telegramSourceId String?       // FK to TelegramMessage (the raw source)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  duration         Int?          // seconds
  playCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category        Category?        @relation(fields: [categoryId], references: [id])
  series          Series?          @relation(fields: [seriesId], references: [id])
  book            Book?            @relation(fields: [bookId], references: [id])
  telegramSource  TelegramMessage? @relation("LessonSource", fields: [telegramSourceId], references: [id])
  tags            LessonTag[]
  media           Media[]

  @@map("lessons")
}

// ─── LessonTag ────────────────────────────────────────────

model LessonTag {
  lessonId String
  tagId    String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lessonId, tagId])
  @@map("lesson_tags")
}

// ─── Media ────────────────────────────────────────────────
// Metadata only — actual files live in storage, not in PostgreSQL.

model Media {
  id              String          @id @default(cuid())
  filename        String
  mimeType        String
  size            Int             // bytes
  duration        Int?            // seconds (audio/video)
  mediaType       MediaType       @default(AUDIO)
  storageKey      String          // path/key within the storage provider
  storageProvider StorageProvider @default(LOCAL)
  lessonId        String?
  bookId          String?
  createdAt       DateTime        @default(now())

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  book   Book?   @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@map("media")
}

// ─── Import ───────────────────────────────────────────────

model Import {
  id          String       @id @default(cuid())
  source      ImportSource
  status      ImportStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime     @default(now())

  createdBy        User?             @relation(fields: [createdById], references: [id])
  telegramMessages TelegramMessage[]

  @@map("imports")
}

// ─── TelegramMessage ──────────────────────────────────────
// Raw Telegram source record. NEVER overwritten by parsed metadata.
// Raw data and suggested metadata are kept strictly separate.

model TelegramMessage {
  id   String @id @default(cuid())

  // ── Raw Telegram source fields (immutable after creation) ──
  messageId          Int
  chatId             String
  caption            String?   // original message caption/text
  text               String?   // alias for caption (kept for compatibility)
  date               DateTime  // original broadcast date
  audioFilename      String?   // original audio filename from Telegram
  telegramFileId     String?   // Telegram file_id (short-lived reference)
  telegramFileUniqueId String? // Telegram file_unique_id (permanent reference)
  links              Json      @default("[]") // URLs found in caption
  rawJson            Json      // complete raw Telegram API payload

  // ── Derived/suggested metadata (separate from raw source) ──
  // These are populated by deterministic parsing or human review.
  // They do NOT modify or replace the raw fields above.
  suggestedMetadata  Json      @default("{}") // { title?, seriesId?, categoryId?, bookId?, lessonNumber?, tags?, confidence? }

  // ── Processing state ──────────────────────────────────────
  importId     String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  import  Import?  @relation(fields: [importId], references: [id])
  lessons Lesson[] @relation("LessonSource")

  @@unique([chatId, messageId])
  @@map("telegram_messages")
}
