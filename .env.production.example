# Production environment variables for Vercel
# Copy these into Vercel → Project Settings → Environment Variables
# Never commit real values to git.

# ── Database (Neon) ───────────────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
# Use the "Pooled connection" string (includes ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-32-random-chars-minimum"

# ── App URL ───────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ── Storage ───────────────────────────────────────────────────────────────────
# For production audio files use S3 or Cloudflare R2
# For now keep LOCAL — audio served via Telegram proxy (see below)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./storage"

# ── Telegram (optional — only needed if running importer on server) ───────────
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_PHONE=""
TELEGRAM_CHANNEL="@SheikhMuhammedZain"

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV="production"
