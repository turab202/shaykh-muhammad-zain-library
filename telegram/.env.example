# ─────────────────────────────────────────────────────────────────
# Telegram Importer — Environment Variables
# Copy to telegram/.env and fill in your values.
# NEVER commit this file or expose these values to the browser/public.
# ─────────────────────────────────────────────────────────────────

# ── Database (same as project .env) ──────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/zain_library?schema=public"

# ── Telegram API credentials ──────────────────────────────────────
# Obtain from: https://my.telegram.org/apps
# These are ACCOUNT-LEVEL credentials, not bot tokens.
TELEGRAM_API_ID="your_api_id_here"
TELEGRAM_API_HASH="your_api_hash_here"

# ── Phone number for Telethon session authentication ─────────────
# International format, e.g. +1234567890
TELEGRAM_PHONE="+1234567890"

# ── Target channel / chat ─────────────────────────────────────────
# The @username or numeric ID of the archive channel.
# Examples: @ShaykhMuhammadZain_Archive  or  -1001234567890
TELEGRAM_CHANNEL="@ShaykhMuhammadZain_Archive"

# ── Storage ───────────────────────────────────────────────────────
# Where to save downloaded audio and PDF files.
# Must match the project-level STORAGE_PROVIDER and LOCAL_STORAGE_PATH.
STORAGE_PROVIDER="LOCAL"
LOCAL_STORAGE_PATH="../storage"
