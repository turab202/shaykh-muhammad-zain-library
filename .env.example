# ─────────────────────────────────────────────
# Muhammad Zain Islamic Digital Library
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────

# PostgreSQL connection string
# For local Docker dev: postgres://postgres:postgres@localhost:5432/zain_library
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zain_library?schema=public"

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-32-char-random-secret"

# Application base URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage provider: "local" | "s3"
# For Phase 1 development, use "local"
STORAGE_PROVIDER="local"

# Local storage base path (relative to project root)
# Only used when STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH="./storage"

# ─── Future / Optional ────────────────────────
# S3-compatible object storage (only needed when STORAGE_PROVIDER=s3)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
